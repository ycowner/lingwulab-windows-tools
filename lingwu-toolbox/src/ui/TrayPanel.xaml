<?xml version="1.0" encoding="utf-8"?>
<!--
  托盘指标面板（Mole 式，2026-10-25 Gate 0 拍板：对照图 B 选列 1）。

  【为什么是一个独立顶层窗口，而不是主窗口里的一个页面】
  托盘左键要弹的是「看一眼当前状态」的小面板。它必须在主窗口隐藏到托盘时
  也能独立出现，而且**不能抢焦点** —— 抢了焦点，用户正在写的文档就被抢走。
  WinUI 3 的 Window 没有 Visibility 属性，主窗口里的 Page 也没法脱离主窗口
  单独显示，所以它只能是一个自己的 Window。

  【版式：360 × 530 DIP】
  【为什么是 530】
  内容（健康分 / 徽章 / 2×2 磁贴 / 电池 / Top 进程 / 动作行 / 入口）
  量出来是 505 客户区 DIP，加上下不可见边框各 7 → 外框至少 519。
  原来的 640 多出来的 121 DIP 全是空白（中间那行 * 撑出来的）。
  有电池时再加 72 DIP（电池条整条要占的高度）——
  高度跟着电池变，见 TrayPanel.xaml.cpp 的 ApplyPanelHeight。

  从上到下：
    ① 健康分（环形色点 + 大数字 + 等级）
    ② 徽章行（CPU 型号 / 内存 / OS / 运行时长）
    ③ 2×2 磁贴（CPU / 内存 / 网络 / 磁盘剩余）
    ④ 电池条（仅笔记本有电池时出现；台式机显示「本机无电池」是另一种说法，
      但「没有电池」和「电池没电」是两件事，所以整条隐藏而不是显示 0%）
    ⑤ Top 进程（名称 / 内存 / CPU）
    ⑥ 动作行（保持常亮 / 清理屏幕）
    ⑦ 打开工具箱

  【为什么磁贴卡片的底色是一个「与内容平级」的 Border，而不是磁贴自己的 Background】
  Border 的 Opacity 会连**子元素一起**变淡 —— 文字也会跟着淡。
  所以底色单独放一个 Border，内容另放一个 Grid，两者重叠。

  【为什么不用 emoji】
  Mole 的「咖啡杯 = 保持常亮」「显示器 = 清理屏幕」在本项目里用**矢量 Path**
  自绘（见下方两个动作按钮）。全项目不使用 emoji。
-->
<Window
    x:Class="LingwuToolbox.TrayPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      外层根：正常态是 RootGrid（面板本体），清理屏态是盖在它上面的 CleanScreen。
      两者做成**兄弟**而不是同一个 Grid 的两行 —— 清理屏要盖住整个窗口
      （含标题栏区），放在行里做不到「铺满」。
    -->
    <Grid x:Name="WindowRoot">
    <Grid x:Name="RootGrid" Padding="13,10,13,11"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
        <Grid.Resources>

            <!-- 卡片底色。同状态页 bento 磁贴的做法：主文字色 @ 6%。
                 【为什么不猜 CardBackgroundFillColorDefaultBrush 之类的键】
                 主题画刷的键名写错一个，InitializeComponent 直接抛
                 0x802B000A「找不到资源」，症状是「窗口一个都建不出来、
                 进程活着、不崩、不写日志」，几乎无法定位。
                 而「主文字色」是本工程已在用、确认存在的键。 -->
            <Style x:Key="CardSurface" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Opacity" Value="0.06" />
            </Style>

            <!-- 指标色块（9×9 的小圆角方块）。 -->
            <Style x:Key="Swatch" TargetType="Border">
                <Setter Property="Width" Value="9" />
                <Setter Property="Height" Value="9" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 磁贴标题。 -->
            <Style x:Key="TileLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 磁贴右上角的徽章（16 核 / 2.6 GHz / Wi-Fi …）。 -->
            <Style x:Key="TileBadge" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9" />
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 磁贴的大数值。 -->
            <Style x:Key="TileValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- 大数值后面的单位（% / GB / MB/s）。 -->
            <Style x:Key="TileUnit" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <!-- 磁贴的副说明行。 -->
            <Style x:Key="TileSub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 徽章行里的小标签文字。 -->
            <Style x:Key="ChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="Opacity" Value="0.78" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 分节标题（Top 进程）。 -->
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Opacity" Value="0.62" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 动作按钮里的文字。 -->
            <Style x:Key="ActionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

        </Grid.Resources>

        <!-- ==================== ① 健康分 ==================== -->
        <!--
          这一行同时是窗口的拖拽区（SetTitleBar）。系统按钮浮在右上角，
          而这一行的内容是**左对齐**的，所以右上角是空的，不会被按钮压住。
        -->
        <Grid x:Name="DragRegion" Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto"
              Height="30">
            <Ellipse x:Name="HealthRing" Width="16" Height="16" StrokeThickness="3"
                     Fill="Transparent" VerticalAlignment="Center" />
            <TextBlock x:Name="PanelScore" Grid.Column="1" Margin="9,0,6,0"
                       FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="PanelGrade" Grid.Column="2" FontSize="12"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- ==================== ② 徽章行 ==================== -->
        <!-- 2×2 网格而不是自动换行：徽章内容长度不可控（一颗 CPU 的型号名
             能有 30 个字符），自动换行会让面板高度忽高忽低。 -->
        <Grid Grid.Row="1" Margin="0,8,0,0" RowSpacing="4" ColumnSpacing="4"
              RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
            <Border x:Name="ChipCpu" Grid.Row="0" Grid.Column="0" CornerRadius="4"
                    Padding="6,3,6,3" Background="{ThemeResource TextFillColorPrimaryBrush}"
                    Opacity="0.10">
                <TextBlock x:Name="BadgeCpu" Style="{StaticResource ChipText}" />
            </Border>
            <Border x:Name="ChipMem" Grid.Row="0" Grid.Column="1" CornerRadius="4"
                    Padding="6,3,6,3" Background="{ThemeResource TextFillColorPrimaryBrush}"
                    Opacity="0.10">
                <TextBlock x:Name="BadgeMem" Style="{StaticResource ChipText}" />
            </Border>
            <Border x:Name="ChipOs" Grid.Row="1" Grid.Column="0" CornerRadius="4"
                    Padding="6,3,6,3" Background="{ThemeResource TextFillColorPrimaryBrush}"
                    Opacity="0.10">
                <TextBlock x:Name="BadgeOs" Style="{StaticResource ChipText}" />
            </Border>
            <Border x:Name="ChipUptime" Grid.Row="1" Grid.Column="1" CornerRadius="4"
                    Padding="6,3,6,3" Background="{ThemeResource TextFillColorPrimaryBrush}"
                    Opacity="0.10">
                <TextBlock x:Name="BadgeUptime" Style="{StaticResource ChipText}" />
            </Border>
        </Grid>

        <!-- ==================== ③ 2×2 磁贴 ==================== -->
        <Grid Grid.Row="2" Margin="0,10,0,0" ColumnSpacing="7" RowSpacing="7"
              ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

            <!-- CPU -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Border Style="{StaticResource CardSurface}" />
                <Grid Padding="9,7,9,6" RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource Swatch}" Background="{StaticResource MetricCpu}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="CPU" Margin="5,0,6,0" />
                        <TextBlock Grid.Column="2" x:Name="TileCpuBadge" Style="{StaticResource TileBadge}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="TileCpuValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="TileCpuUnit" Style="{StaticResource TileUnit}" Text="%" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TileCpuSub" Style="{StaticResource TileSub}" />
                    <Grid x:Name="TileCpuSparkHost" Grid.Row="3" Height="14"
                          VerticalAlignment="Bottom" Margin="0,3,0,0">
                        <Path x:Name="TileCpuSpark" Stroke="{StaticResource MetricCpu}"
                              StrokeThickness="1.4" Stretch="None"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- 内存 -->
            <Grid Grid.Row="0" Grid.Column="1">
                <Border Style="{StaticResource CardSurface}" />
                <Grid Padding="9,7,9,6" RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource Swatch}" Background="{StaticResource MetricMemory}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="内存" Margin="5,0,6,0" />
                        <TextBlock Grid.Column="2" x:Name="TileMemBadge" Style="{StaticResource TileBadge}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="TileMemValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="TileMemUnit" Style="{StaticResource TileUnit}" Text="%" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TileMemSub" Style="{StaticResource TileSub}" />
                    <Grid x:Name="TileMemBarHost" Grid.Row="3" Height="4"
                          VerticalAlignment="Bottom" Margin="0,5,0,0">
                        <Border CornerRadius="2" Background="{ThemeResource TextFillColorPrimaryBrush}"
                                Opacity="0.12" />
                        <Border x:Name="TileMemFill" CornerRadius="2" HorizontalAlignment="Left" Width="0"
                                Background="{StaticResource MetricMemory}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- 网络 -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Border Style="{StaticResource CardSurface}" />
                <Grid Padding="9,7,9,6" RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource Swatch}" Background="{StaticResource MetricNet}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="网络" Margin="5,0,6,0" />
                        <TextBlock Grid.Column="2" x:Name="TileNetBadge" Style="{StaticResource TileBadge}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="TileNetValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="TileNetUnit" Style="{StaticResource TileUnit}" Text="KB/s" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TileNetSub" Style="{StaticResource TileSub}" />
                    <Grid x:Name="TileNetSparkHost" Grid.Row="3" Height="14"
                          VerticalAlignment="Bottom" Margin="0,3,0,0">
                        <Path x:Name="TileNetSpark" Stroke="{StaticResource MetricNet}"
                              StrokeThickness="1.4" Stretch="None"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- 磁盘剩余 -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Border Style="{StaticResource CardSurface}" />
                <Grid Padding="9,7,9,6" RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource Swatch}" Background="{StaticResource MetricDiskFree}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="磁盘剩余" Margin="5,0,6,0" />
                        <TextBlock Grid.Column="2" x:Name="TileDiskBadge" Style="{StaticResource TileBadge}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="TileDiskValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="TileDiskUnit" Style="{StaticResource TileUnit}" Text="GB" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TileDiskSub" Style="{StaticResource TileSub}" />
                    <Grid x:Name="TileDiskBarHost" Grid.Row="3" Height="4"
                          VerticalAlignment="Bottom" Margin="0,5,0,0">
                        <Border CornerRadius="2" Background="{ThemeResource TextFillColorPrimaryBrush}"
                                Opacity="0.12" />
                        <Border x:Name="TileDiskFill" CornerRadius="2" HorizontalAlignment="Left" Width="0"
                                Background="{StaticResource MetricDiskFree}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== ④ 电池条 ==================== -->
        <!-- 没有电池的机器上整条隐藏。「没有电池」和「电池没电」是两件事，
             显示 0% 是在撒谎。 -->
        <Grid x:Name="BatteryCard" Grid.Row="3" Margin="0,7,0,0" Visibility="Collapsed">
            <Border Style="{StaticResource CardSurface}" />
            <Grid Padding="9,7,9,6" RowDefinitions="Auto,Auto,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Style="{StaticResource Swatch}" Background="{StaticResource MetricBattery}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="电池" Margin="5,0,6,0" />
                    <TextBlock Grid.Column="2" x:Name="TileBatteryBadge" Style="{StaticResource TileBadge}" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="TileBatteryValue" Style="{StaticResource TileValue}" />
                    <TextBlock x:Name="TileBatteryUnit" Style="{StaticResource TileUnit}" Text="%" />
                </StackPanel>
                <TextBlock Grid.Row="2" x:Name="TileBatterySub" Style="{StaticResource TileSub}" />
            </Grid>
        </Grid>

        <!-- ==================== ⑤ Top 进程 ==================== -->
        <Grid Grid.Row="4" Margin="0,11,0,0" ColumnDefinitions="Auto,*">
            <TextBlock Style="{StaticResource SectionLabel}" Text="Top 进程" />
            <Border Grid.Column="1" Height="1" Margin="8,0,0,0" VerticalAlignment="Center"
                    Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.14" />
        </Grid>

        <!-- 进程表本体由 C++ 建（见 TrayPanel.xaml.cpp 的 BuildProcessTable）：
             五行固定行数、每秒原地改文字，用 DataTemplate + 绑定 machinery
             换来的只是一堆不必要的间接层。 -->
        <Grid x:Name="ProcListGrid" Grid.Row="5" Margin="0,4,0,0" />

        <!-- ==================== ⑥ 动作行 ==================== -->
        <Grid Grid.Row="7" Margin="0,11,0,0" ColumnDefinitions="*,*" ColumnSpacing="7">
            <!-- 保持常亮：矢量咖啡杯（Mole 用的是咖啡杯，这里不用 emoji）。
                 Path 的 Data 是 WinUI 的路径标记语言，只认 M/L/H/V/C/S/Q/T/A/Z。

                 【为什么 Fill 写 Transparent 而不是 None】
                 WinUI 3 没有 WPF 那个「None」Brush 文本。写 Fill="None"
                 会在 InitializeComponent 里抛
                     0x802B000A  Failed to create a 'Microsoft.UI.Xaml.Media.Brush'
                                from the text 'None'
                 而症状是「整个应用起不来」：面板是主窗口的成员，
                 它的 InitializeComponent 一抛，主窗口的构造函数体根本轮不到执行，
                 一个窗口都建不出来。 -->
            <Button x:Name="KeepAwakeButton" Height="30" Padding="0" CornerRadius="7"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="Transparent"
                          Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                          StrokeThickness="1.6"
                          Data="M 3,7 L 14,7 L 14,12.5 L 3,12.5 Z M 14,8 L 17,8 L 17,11.5 L 14,11.5 M 6,3.5 L 6,5.5 M 9,3 L 9,5" />
                    <TextBlock Style="{StaticResource ActionLabel}" Text="保持常亮" />
                </StackPanel>
            </Button>

            <!-- 清理屏幕：矢量显示器。 -->
            <Button x:Name="CleanScreenButton" Grid.Column="1" Height="30" Padding="0"
                    CornerRadius="7" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="Transparent"
                          Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                          StrokeThickness="1.6"
                          Data="M 2.5,4 L 21.5,4 L 21.5,16 L 2.5,16 Z M 9,20 L 15,20 M 12,16 L 12,20" />
                    <TextBlock Style="{StaticResource ActionLabel}" Text="清理屏幕" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== ⑦ 打开工具箱 ==================== -->
        <Button x:Name="OpenMainButton" Grid.Row="8" Height="32" Margin="0,8,0,0"
                CornerRadius="7" HorizontalAlignment="Stretch"
                Background="{StaticResource AccentStatus}" Foreground="White"
                FontSize="12" FontWeight="SemiBold"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Content="打开工具箱" />

        <!--
          画刷探针。
          【为什么需要探针】
          ThemeResource 只在 XAML 解析期生效，C++ 侧没有别的取法 ——
          想用「主文字色调淡」当动作按钮的底色，就得先把主题画刷**读出来**。
          这里放一个 0×0 的 Border 当探针，C++ 从它的 Background 上取到
          已按当前主题解析好的画刷，再照着调出需要的透明度。
          （主窗口的页签主色探针是同一套做法。）
          键名只用本工程已确认存在的那些，不猜。
        -->
        <Border x:Name="FillProbe" Width="0" Height="0" Opacity="0"
                Background="{ThemeResource TextFillColorPrimaryBrush}" />

        <!-- 健康分的三档等级色探针。健康分会随负载变好变坏，
             环形色点与等级文字要跟着换色 —— 颜色在 App.xaml 里定义一次，
             C++ 侧从这里读回来用，不在两处各写一份色值。 -->
        <Border x:Name="HealthGoodProbe" Width="0" Height="0" Visibility="Collapsed"
                Background="{StaticResource HealthGood}" />
        <Border x:Name="HealthWarnProbe" Width="0" Height="0" Visibility="Collapsed"
                Background="{StaticResource HealthWarn}" />
        <Border x:Name="HealthBadProbe" Width="0" Height="0" Visibility="Collapsed"
                Background="{StaticResource HealthBad}" />
    </Grid>

    <!--
      清理屏。
      【为什么不用第二个顶层窗口】
      多一个 Window 就多一份「只要它活着 XAML 消息循环就不结束」的约束，
      退出序列必须多一个关闭步骤，漏一步就是「窗口全没了但进程还在」的僵留。
      复用本窗口进入「全屏纯色」状态，把这条约束消掉了。

      【为什么底部留一行提示】
      计划里写的是「全屏纯色窗口」，但一个没有出口提示的黑屏会让用户
      以为程序卡死。这里只放一行极淡的字，屏幕该遮的还是遮住了。

      【底色为什么写死】
      这个屏的作用就是「把屏幕清空」，颜色要稳定，不跟着系统主题变。
    -->
    <Grid x:Name="CleanScreen" Visibility="Collapsed" Background="#101014">
        <!-- 【为什么这行字要报「输入锁没锁上」】
             锁输入（BlockInput）要管理员权限，进程不是管理员时锁不上。
             这种情况下键盘照常能动，用户会以为程序坏了 ——
             把实际状态写出来，他才知道不是 bug。 -->
        <TextBlock x:Name="CleanScreenHint"
                   Text="按 Esc 退出清理屏幕"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,28" FontSize="12" Opacity="0.35"
                   Foreground="White" />
    </Grid>
    </Grid>
</Window>
