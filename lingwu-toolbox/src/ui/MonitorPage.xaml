<?xml version="1.0" encoding="utf-8"?>
<!-- 性能监视模块。挂在工具箱外壳窗口里的一个 Page，不是顶层窗口。

     【为什么根元素是 Page 而不是 Window】
     合并后整个工具箱只有一个顶层窗口（MainWindow 外壳）。
     窗口级 API（AppWindow / ExtendsContentIntoTitleBar / Closing / Hide）
     全部归外壳，两个模块各自降级成同窗口内的页面。

     【标题栏为什么不在这里】
     标题栏是窗口级的，导航切换控件也放在那里。
     原来这一行（Row=0，48 高，自绘标题栏）已经上移到外壳。

     【版式（Mole Status 形态，2026-10-25 Gate 0 拍板）】
     从上到下四段：
       ① bento 磁贴区（4 列 × 2 行，共 8 块）
       ② 命令栏（搜索 / 按应用聚合 / 设置）
       ③ 进程表（表头 + 列表）
       ④ 状态栏
     磁贴区铺满内容宽（左右各留 32 DIP 边距），4 列等分。
     【为什么不加 MaxWidth 收口】
     试过 MaxWidth=1000 + HorizontalAlignment=Center，结果是磁贴区
     宽度**塌陷成内容宽**：星号列在 Center 布局下按内容计算尺寸，
     8 块磁贴被撑成 76~161 DIP 不等宽，4×2 的网格彻底散架。
     去掉之后磁贴按可用宽度均分（本机 4×约 311 DIP），网格才成行成列。 -->
<Page
    x:Class="LingwuToolbox.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LingwuToolbox">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Grid.Resources>
            <!-- ============ 磁贴样式 ============ -->

            <!-- 磁贴卡片的填充。
                 【为什么用「主文字色 @ 6%」而不是主题卡片画刷】
                 主题画刷的键名（CardBackgroundFillColorDefaultBrush 之类）
                 **不能靠猜** —— 写错一个键名，InitializeComponent 直接抛
                 0x802B000A「找不到资源」，症状是「窗口一个都建不出来、
                 进程活着、不崩、不写日志」，几乎无法定位。
                 而「主文字色」是本工程已在用、确认存在的键：
                 深色主题下它近白（6% 白叠在深底 = 微微发亮的卡片），
                 浅色主题下它近黑（6% 黑叠在浅底 = 微微发灰的卡片），
                 两种主题都得到「比背景略深一点」的卡片感，且零风险。 -->
            <Style x:Key="TileSurface" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Opacity" Value="0.06" />
            </Style>

            <!-- 磁贴里的指标色块（11×11 的小圆角方块）。 -->
            <Style x:Key="TileSwatch" TargetType="Border">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 磁贴标题（健康 / CPU / 内存 …）。 -->
            <Style x:Key="TileLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 磁贴右上角的徽章（16 核 / 2.6 GHz / Wi-Fi …）。 -->
            <Style x:Key="TileBadge" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 磁贴的大数值。 -->
            <Style x:Key="TileValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="23" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- 大数值后面的单位（% / GB / MB/s）。 -->
            <Style x:Key="TileUnit" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Margin" Value="0,0,0,3" />
            </Style>

            <!-- 磁贴的副说明行。 -->
            <Style x:Key="TileSub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- ============ 进程行 ============ -->

            <!-- 行模板。

                 这里用经典 {Binding} 而不是 x:Bind，是被 WMC1506 逼出来的：
                     WMC1506  OneWay bindings require at least one of their steps
                              to support raising notifications
                 x:Bind 是**编译期**绑定，它凭元数据判断源类型支不支持通知。
                 ProcessRow 的 INotifyPropertyChanged 是**只在 C++ 侧**用
                 ProcessRowT<ProcessRow, INotifyPropertyChanged> 的模板参数实现的，
                 并没写进 ProcessRow.idl —— 因为 WinUI 的 NuGet 包不提供
                 Microsoft.UI.Xaml.Data.idl，midl 没法 import；
                 改用 import "Windows.Foundation.idl" 则会把整条 SDK IDL 链拖进来，
                 报 MIDL2003 redefinition 风暴。
                 于是编译器认为不支持通知，把 OneWay 静默降级成一次性读取：
                 实测状态栏网速在变、列表里的 CPU/内存 9 秒纹丝不动。

                 经典 {Binding} 则是在运行期订阅 INotifyPropertyChanged，
                 纯 C++ 实现的 INPC 照样接得上。代价是走反射路径，
                 但每秒只有几百次属性读取，换来的是数值真的在刷新。

                 但它还有第二个前提，漏了会静默失败：源对象必须自己实现
                 Microsoft.UI.Xaml.Data.ICustomPropertyProvider。
                 官方《Binding 标记扩展》文档写得很直白：
                 「在 C++/WinRT 中使用 {Binding}，你需要实现
                   ICustomPropertyProvider 和 ICustomProperty 接口。」
                 缺了它的表现与「绑定写错路径」一模一样 —— 行容器在、
                 Items().Size() 正确、状态栏照常刷新，就是一个字都不显示。
                 实现见 ProcessRow.h；其中 provider 的 Type() 必须返回
                 Metadata + 真实类名，写成 Primitive/"String" 会在启动约
                 5 秒后以 0xc000027b 崩在 Microsoft.UI.Xaml.dll 里。

                 实测：{Binding} 的路径解析最终走的是**元数据**
                 （XamlTypeInfo），GetCustomProperty 一次都没被调用，
                 引擎只用 Type() 确认这是个自定义类型。所以元数据里
                 必须能看到这几个属性 —— 它们本来就在 ProcessRow.idl 里。

                 【列序：内存在前、CPU 在后】
                 与 Mole 的进程表一致：内存是用户最常盯的一列，放在最显眼的
                 倒数第二列位置比 CPU 更早进入视线。
                 图标列在最左（36 DIP），PID 列在 CPU 之后。

                 【行高 40】
                 图标是 26×26，行高必须容得下它再加上下留白。
                 这个 40 必须与 MonitorPage.xaml.cpp 里的 kRowHeight 一致 ——
                 右键命中测试是**算术**定位（y / 行高），两边对不上就会点错行。 -->
            <DataTemplate x:Key="ProcessRowTemplate">
                <Grid Height="40" ColumnDefinitions="36,*,96,76,60,64">
                    <!-- 图标位：应用名的首字母徽章。 -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="6"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource TextFillColorPrimaryBrush}"
                                Opacity="0.10" />
                        <TextBlock Text="{Binding IconText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.75" />
                    </Grid>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding MemText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CpuText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Opacity="0.85" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding PidText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Opacity="0.6" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding CountText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Opacity="0.85" />
                </Grid>
            </DataTemplate>

            <!-- 表头单元格：透明底、无边框、整格可点。Win11 表格表头的标准做法。 -->
            <Style x:Key="ColumnHeaderButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,0,0,0" />
                <Setter Property="Height" Value="28" />
                <!-- HorizontalAlignment=Stretch 是对齐的关键，不要删。
                     WinUI 3 的 DefaultButtonStyle 硬设了 HorizontalAlignment=Left
                     （见 WinUI 包 generic.xaml 的 DefaultButtonStyle），
                     按钮因此被内容尺寸化并贴在 Grid 列的**左缘**；
                     此时外面写 HorizontalContentAlignment="Right"、
                     内容里再写一遍 HorizontalAlignment="Right" 全都无效 ——
                     按钮只包住内容，右对齐没有空间可对齐。
                     实测三列表头标签比同列数值右缘偏左 38~69 DIP。
                     拉伸填满整列之后，内容右缘才等于列右缘，
                     与行模板里 TextBlock 的右对齐天然对齐。 -->
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!--
              行容器样式。

              这里**只**改属性，不覆写 ControlTemplate。
              曾经试过把 ListViewItem 的模板换成「只有 ListViewItemPresenter」的
              极简版以做出圆角选中，实测会在列表第一次填充时抛
                  STATUS_STOWED_EXCEPTION (0xC000027B)，故障模块 CoreMessagingXP.dll
              症状是「进程在 ItemsSource 赋值处静默死掉、窗口一闪就没」，
              而事件日志里没有任何托管异常，只能靠链接器 map + 逐步 trace 定位。
              代价只是选中高亮回到直角块 —— 圆角选中留到后面用别的方式补。
            -->
            <Style x:Key="ProcessListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
        </Grid.Resources>

        <!-- ============================ bento 磁贴区 ============================ -->
        <!--
          8 块磁贴，4 列 × 2 行。

          【为什么卡片底色是一个单独的 Border，而不是磁贴自己的 Background】
          卡片底色要用「主文字色 @ 6%」实现半透明效果。而 Border 的 Opacity
          会连**子元素一起**变淡 —— 文字也会跟着淡。所以底色是一个与内容
          平级的 Border，内容另放一个 Grid，两者重叠。
        -->
        <Grid x:Name="TileArea" Grid.Row="0" Margin="32,10,32,2"
              ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto"
              ColumnSpacing="12" RowSpacing="12">

            <!-- · 1 健康 · -->
            <Grid Grid.Row="0" Grid.Column="0" Height="110">
                <Border Style="{StaticResource TileSurface}" />
                <Grid Padding="12,8,12,8" RowDefinitions="Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource TileSwatch}" Background="{StaticResource MetricHealth}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="健康" Margin="6,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="TileHealthBadge" Style="{StaticResource TileBadge}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                        <TextBlock x:Name="TileHealthValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="TileHealthUnit" Style="{StaticResource TileUnit}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TileHealthSub" Style="{StaticResource TileSub}" Margin="0,2,0,0" />
                    <Grid x:Name="TileHealthSparkHost" Grid.Row="3" Height="24" VerticalAlignment="Bottom" Margin="0,2,0,0">
                        <Path x:Name="TileHealthSpark"
                              Stroke="{StaticResource MetricHealth}" StrokeThickness="1.6"
                              Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- · 2 CPU · -->
            <Grid Grid.Row="0" Grid.Column="1" Height="110">
                <Border Style="{StaticResource TileSurface}" />
                <Grid Padding="12,8,12,8" RowDefinitions="Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource TileSwatch}" Background="{StaticResource MetricCpu}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="CPU" Margin="6,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="TileCpuBadge" Style="{StaticResource TileBadge}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                        <TextBlock x:Name="TileCpuValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="TileCpuUnit" Style="{StaticResource TileUnit}" Text="%" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TileCpuSub" Style="{StaticResource TileSub}" Margin="0,2,0,0" />
                    <Grid x:Name="TileCpuSparkHost" Grid.Row="3" Height="24" VerticalAlignment="Bottom" Margin="0,2,0,0">
                        <Path x:Name="TileCpuSpark"
                              Stroke="{StaticResource MetricCpu}" StrokeThickness="1.6"
                              Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- · 3 内存 · -->
            <Grid Grid.Row="0" Grid.Column="2" Height="110">
                <Border Style="{StaticResource TileSurface}" />
                <Grid Padding="12,8,12,8" RowDefinitions="Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource TileSwatch}" Background="{StaticResource MetricMemory}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="内存" Margin="6,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="TileMemoryBadge" Style="{StaticResource TileBadge}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                        <TextBlock x:Name="TileMemoryValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="TileMemoryUnit" Style="{StaticResource TileUnit}" Text="%" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TileMemorySub" Style="{StaticResource TileSub}" Margin="0,2,0,0" />
                    <Grid Grid.Row="3" Height="5" VerticalAlignment="Bottom" Margin="0,4,0,2" x:Name="TileMemoryBarHost">
                        <Border CornerRadius="3"
                                Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.12" />
                        <Border x:Name="TileMemoryFill" CornerRadius="3"
                                Background="{StaticResource MetricMemory}"
                                HorizontalAlignment="Left" Width="0" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- · 4 磁盘剩余 · -->
            <Grid Grid.Row="0" Grid.Column="3" Height="110">
                <Border Style="{StaticResource TileSurface}" />
                <Grid Padding="12,8,12,8" RowDefinitions="Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource TileSwatch}" Background="{StaticResource MetricDiskFree}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="磁盘剩余" Margin="6,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="TileDiskFreeBadge" Style="{StaticResource TileBadge}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                        <TextBlock x:Name="TileDiskFreeValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="TileDiskFreeUnit" Style="{StaticResource TileUnit}" Text="GB" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TileDiskFreeSub" Style="{StaticResource TileSub}" Margin="0,2,0,0" />
                    <Grid Grid.Row="3" Height="5" VerticalAlignment="Bottom" Margin="0,4,0,2" x:Name="TileDiskFreeBarHost">
                        <Border CornerRadius="3"
                                Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.12" />
                        <Border x:Name="TileDiskFreeFill" CornerRadius="3"
                                Background="{StaticResource MetricDiskFree}"
                                HorizontalAlignment="Left" Width="0" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- · 5 网络 · -->
            <Grid Grid.Row="1" Grid.Column="0" Height="110">
                <Border Style="{StaticResource TileSurface}" />
                <Grid Padding="12,8,12,8" RowDefinitions="Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource TileSwatch}" Background="{StaticResource MetricNet}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="网络" Margin="6,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="TileNetBadge" Style="{StaticResource TileBadge}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                        <TextBlock x:Name="TileNetValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="TileNetUnit" Style="{StaticResource TileUnit}" Text="MB/s" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TileNetSub" Style="{StaticResource TileSub}" Margin="0,2,0,0" />
                    <Grid x:Name="TileNetSparkHost" Grid.Row="3" Height="24" VerticalAlignment="Bottom" Margin="0,2,0,0">
                        <Path x:Name="TileNetSpark"
                              Stroke="{StaticResource MetricNet}" StrokeThickness="1.5"
                              Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- · 6 磁盘活动 · -->
            <Grid Grid.Row="1" Grid.Column="1" Height="110">
                <Border Style="{StaticResource TileSurface}" />
                <Grid Padding="12,8,12,8" RowDefinitions="Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource TileSwatch}" Background="{StaticResource MetricDiskAct}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="磁盘活动" Margin="6,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="TileDiskActBadge" Style="{StaticResource TileBadge}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                        <TextBlock x:Name="TileDiskActValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="TileDiskActUnit" Style="{StaticResource TileUnit}" Text="%" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TileDiskActSub" Style="{StaticResource TileSub}" Margin="0,2,0,0" />
                    <Grid x:Name="TileDiskActSparkHost" Grid.Row="3" Height="24" VerticalAlignment="Bottom" Margin="0,2,0,0">
                        <Path x:Name="TileDiskActSpark"
                              Stroke="{StaticResource MetricDiskAct}" StrokeThickness="1.6"
                              Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- · 7 电池 · -->
            <!-- 无电池的机器上这块显示「本机无电池」，不假装成 0%。 -->
            <Grid Grid.Row="1" Grid.Column="2" Height="110">
                <Border Style="{StaticResource TileSurface}" />
                <Grid Padding="12,8,12,8" RowDefinitions="Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource TileSwatch}" Background="{StaticResource MetricBattery}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TileLabel}" Text="电池" Margin="6,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="TileBatteryBadge" Style="{StaticResource TileBadge}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                        <TextBlock x:Name="TileBatteryValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="TileBatteryUnit" Style="{StaticResource TileUnit}" Text="%" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TileBatterySub" Style="{StaticResource TileSub}" Margin="0,2,0,0" />
                    <Grid Grid.Row="3" Height="5" VerticalAlignment="Bottom" Margin="0,4,0,2" x:Name="TileBatteryBarHost">
                        <Border CornerRadius="3"
                                Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.12" />
                        <Border x:Name="TileBatteryFill" CornerRadius="3"
                                Background="{StaticResource MetricBattery}"
                                HorizontalAlignment="Left" Width="0" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- · 8 GPU 监控（占位） · -->
            <!--
              诚实的占位：这一块本轮**不做**，所以写明「本轮不做」，
              而不是画一条会骗人的假曲线。
              要做 GPU 占用得引 PDH（新增链接依赖），本轮不引。
            -->
            <Grid Grid.Row="1" Grid.Column="3" Height="110">
                <Border CornerRadius="10"
                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                        BorderThickness="1" Opacity="0.22" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45">
                    <TextBlock Text="GPU 磁贴" FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock Text="本轮不做" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================ 命令栏 ============================ -->
        <Grid x:Name="CommandBar" Grid.Row="1" Margin="32,4,32,12" ColumnDefinitions="*,Auto">
            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="0"
                            Width="300"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            PlaceholderText="搜索进程名" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                <ToggleSwitch x:Name="AggregateSwitch"
                              VerticalAlignment="Center"
                              OnContent="按应用聚合"
                              OffContent="逐进程" />
                <Button x:Name="SettingsButton" Content="设置" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============================ 表头（点击排序） ============================ -->
        <!-- 列宽必须与 ProcessRowTemplate 的 ColumnDefinitions 完全一致：
             图标 36 / 名称 * / 内存 96 / CPU 76 / PID 60 / 进程数 64 -->
        <Grid x:Name="HeaderGrid" Grid.Row="2" Height="32" Margin="32,0,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>

            <Button x:Name="HeaderName" Grid.Column="1" Style="{StaticResource ColumnHeaderButton}"
                    HorizontalContentAlignment="Left" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="名称" />
                    <Path x:Name="ArrowName" Width="9" Height="9" VerticalAlignment="Center"
                          Fill="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                          Data="M 0,5 L 9,5 L 4.5,0 Z" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="RotName" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                </StackPanel>
            </Button>

            <Button x:Name="HeaderMem" Grid.Column="2" Style="{StaticResource ColumnHeaderButton}"
                    HorizontalContentAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Path x:Name="ArrowMem" Width="9" Height="9" VerticalAlignment="Center"
                          Fill="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed"
                          Data="M 0,5 L 9,5 L 4.5,0 Z" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="RotMem" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Text="内存" />
                </StackPanel>
            </Button>

            <Button x:Name="HeaderCpu" Grid.Column="3" Style="{StaticResource ColumnHeaderButton}"
                    HorizontalContentAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Path x:Name="ArrowCpu" Width="9" Height="9" VerticalAlignment="Center"
                          Fill="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                          Data="M 0,5 L 9,5 L 4.5,0 Z" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="RotCpu" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Text="CPU" />
                </StackPanel>
            </Button>

            <!-- PID 不可排序（它是身份不是量），所以是静态标签。 -->
            <TextBlock Grid.Column="4" Text="PID"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Opacity="0.6" Style="{ThemeResource CaptionTextBlockStyle}" />

            <Button x:Name="HeaderProc" Grid.Column="5" Style="{StaticResource ColumnHeaderButton}"
                    HorizontalContentAlignment="Right">
                <TextBlock Text="进程数" />
            </Button>
        </Grid>

        <!-- ============================ 列表 ============================ -->
        <!-- 左右 Padding 与 HeaderGrid 的 Margin="32,0,32,0" 是同一组不变量，
             四个元素（CommandBar / HeaderGrid / 本列表 / StatusBar）必须成组相等，
             否则左右基线会错开 —— 单改一处只错半边，肉眼极易放过。

             右半边的下界来自 WinUI 覆盖式滚动条：ScrollBarSize = 16 DIP，
             而滚动条不占布局空间（ScrollContentPresenter 用 Grid.ColumnSpan=2
             横跨两列，滑块直接盖在内容之上），所以右内边距必须 ≥ 16 DIP，
             滑块才只压空白、不盖住最右侧的数值。当前取 32，比下界多留 16 DIP 余量。
             曾经右内边距写成 8，数据列整体比表头右移 8 DIP（CPU/内存/进程数三列全歪）；
             调小之前先想清楚是不是在破坏这个下界。

             注意这里必须用 Padding 而不是 Margin：ListView 模板会把 Padding
             透传给内部 ItemsPresenter，行内容与滚动视口一起内缩；
             换成 Margin 的话右侧会留不出一块被内缩的死区。

             命令栏与状态栏的垂直边距（顶 4/底 12、底 8）与本元素不同，
             所以四个元素共享的只是水平分量。 -->
        <ListView x:Name="ProcessList"
                  Grid.Row="3"
                  ItemTemplate="{StaticResource ProcessRowTemplate}"
                  ItemContainerStyle="{StaticResource ProcessListItemStyle}"
                  SelectionMode="Single"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollMode="Auto"
                  Padding="32,0,32,0">
            <!--
              列表面板：显式写出 ItemsStackPanel，并把 CacheLength 设成 0。

              【为什么必须显式写这一段 —— 2026-10-25 实测】
              WinUI 3 里 ListView 的默认面板**本来就是** ItemsStackPanel
              （见 winui 2.3.9 的 generic.xaml，<Style TargetType="ListView">
              那段的 ItemsPanel Setter；<Style TargetType="ListBox"> 才是
              VirtualizingStackPanel —— 这两个别搞混）。
              但默认的 ItemsStackPanel 预实现的行数远超视口：
              视口 541 DIP（16.9 行）实测一次实现 **86 个行容器**，
              正好是视口行数 × 5。

              这 86 个容器每个约 0.21 MB，是常驻内存里最大的一块可控成本：
                实现容器 86 → 18（只留视口内的行，外加 1 行余量）
                监控页容器成本   18.0 MB → 3.8 MB
                25 轮互切峰值    192.7 MB → 134.0 MB
                逐槽 SetAt 次数  927 → 260（容器少了，重排的代价同比下降）

              CacheLength=0 的意思是「视口之外一行都不预先实现」，
              滚到哪实现到哪。面板类型没有换（还是 ItemsStackPanel），
              只改了缓存长度，所以滚动、选中、右键命中算术定位
              （见 MonitorPage.xaml.cpp 里 kRowHeight 那段）都不受影响。
            -->
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" CacheLength="0" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>

        <!-- ============================ 状态栏 ============================ -->
        <Grid x:Name="StatusBar" Grid.Row="4" Height="30" Margin="32,0,32,8"
              ColumnDefinitions="*,Auto">
            <TextBlock x:Name="StatusLeft" Grid.Column="0"
                       VerticalAlignment="Center"
                       Opacity="0.85"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="StatusRight" Grid.Column="1"
                       VerticalAlignment="Center"
                       Opacity="0.85"
                       TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
        </Grid>

    </Grid>
</Page>
