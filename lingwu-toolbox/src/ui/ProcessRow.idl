// ProcessRow.idl - C++/WinRT component declaration.
//
// IMPORTANT: this file MUST stay pure ASCII.
// MIDL reads source files using the system ANSI code page (936 on zh-CN),
// not UTF-8. Chinese comments here raise C4819, and this project builds with
// /WX. Same trap class as build.bat and the .ps1 scripts.
//
// Why ProcessRow is a runtimeclass at all:
//   The obvious thing is a plain C++ struct + x:Bind, but x:Bind only works
//   when the XAML compiler can resolve the members at compile time, and it
//   resolves them against types found in **metadata**. A plain struct is in
//   no winmd, so the build stops with
//     WMC0909  Cannot resolve DataType local:ProcessRow
//     WMC1111  DataTemplates containing x:Bind need a DataType
//   (both reproduced on this project before this file existed).
//
//   Declaring it here puts it into our own winmd -- the same one
//   MainWindow.idl already produces.
//
// IMPORTANT -- why INotifyPropertyChanged is NOT listed here:
//
//   The row object has to notify XAML when its values change, and that is
//   implemented in C++ by passing the interface as an extra template argument
//   to ProcessRowT:
//
//     struct ProcessRow
//         : ProcessRowT<ProcessRow, Windows::Foundation::INotifyPropertyChanged>
//
//   cppwinrt emits
//     template <typename D, typename... I>
//     using ProcessRowT = ProcessRow_base<D, I...>;
//     template <typename D, typename... I>
//     struct ProcessRow_base : implements<D, LingwuToolbox::ProcessRow, I...>
//   so the extra interface lands in the QI table with its real IID and XAML
//   finds it at runtime by QueryInterface. The winmd does not need to list it.
//
//   Putting it in this file instead was tried and does NOT work:
//
//     import "Windows.Foundation.idl";
//         -> MIDL2003 redefinition cascade over the whole SDK IDL chain
//            (_FLAGGED_WORD_BLOB, IUnknown, HSTRING__, IInspectable,
//            TrustLevel, AsyncStatus, ...) because the SDK files assume a
//            different midl configuration than a hand-written component.
//
//     interface Windows.Foundation.INotifyPropertyChanged;  (body form)
//         -> MIDL2009 undefined symbol: Windows.Foundation.INotifyPropertyChanged
//
//     [default] interface IProcessRow;   (namespace level)
//         -> MIDL2025 syntax error: expecting ] or , near "default"
//
//     runtimeclass X : Windows.Foundation.INotifyPropertyChanged
//         -> same MIDL2009.
//
//   For reference, MIDL 3.0 does want the interface list inside the
//   runtimeclass body with [default] on the right line (see
//   <sdk>/Include/10.0.19041.0/winrt/windows.ui.composition.idl:2727), but
//   that is only reachable for interfaces this file itself declares.

namespace LingwuToolbox
{
    // [bindable] -- TRIED, DOES NOT WORK HERE. Kept as a note so nobody retries it.
    //
    // The Windows App SDK doc says BindableAttribute is the alternative to
    // implementing ICustomPropertyProvider for {Binding}, and it would also be
    // the natural way to make x:Bind Mode=OneWay recognize notifications.
    // Adding [bindable] to this runtimeclass builds fine -- and is **silently
    // ignored**: no warning, and the emitted ProcessRow.winmd contains no
    // BindableAttribute (verified by dumping the metadata string heap: it has
    // VersionAttribute / GuidAttribute / DefaultAttribute / ActivatableAttribute
    // / MarshallingBehaviorAttribute / ThreadingAttribute, but no bindable one).
    // The attribute is declared in the SDK's windows.ui.xaml.customattributes.idl
    // and WinRTBase.idl, but this MIDL/sdk combination will not emit it for a
    // hand-written C++/WinRT component, and the Microsoft.UI.Xaml.Data winmd is
    // not shipped as an importable idl by the NuGet package.
    //
    // So the notification path used by this project is: x:Bind is NOT usable
    // (WMC1506 downgrades OneWay to one-time), and the row is bound with the
    // classic {Binding} markup extension, which requires ProcessRow to
    // implement ICustomPropertyProvider. See ProcessRow.h.
    [default_interface]
    runtimeclass ProcessRow
    {
        // Activatable, so the factory_implementation in ProcessRow.h is
        // required even though MainWindow only builds rows with make<>().
        ProcessRow();

        // Display fields. Every value is pre-formatted when the row is built;
        // nothing is formatted inside the XAML tree.
        String Name      { get; };
        String CpuText   { get; };
        String MemText   { get; };
        String CountText { get; };

        // Logical values.
        Double  CpuNorm  { get; };
        UInt64  MemBytes { get; };
        UInt32  Procs    { get; };

        // PIDs are NOT stored per row: one array per row would mean roughly
        // 430 extra heap allocations per refresh. This reuses the flat pid
        // table + pidStart/pidCount contract already proven in the core layer;
        // the real array lives in MainWindow (rowPids_).
        UInt32  PidStart { get; };
        UInt32  PidCount { get; };

        // In-place update. This is the whole point of the row object living
        // across frames: MainWindow calls Update() every second, the object
        // raises PropertyChanged for the fields that actually changed, and the
        // ListView containers are never torn down and re-created.
        //
        // It has to be declared here rather than kept as a C++-only helper
        // because the projected type is all MainWindow ever holds. Update is
        // not on the projected class otherwise, and this cppwinrt
        // (3.0.260818.1) has no winrt::get_implementation to get back from the
        // projection to the implementation object -- a full search of the
        // generated projection headers finds nothing but unrelated
        // XDocument.get_Implementation hits.
        void Update(String name,
                    String cpuText,
                    String memText,
                    String countText,
                    Double  cpuNorm,
                    UInt64  memBytes,
                    UInt32  procs,
                    UInt32  pidStart,
                    UInt32  pidCount);
    }
}