<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LingwuToolbox.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置">

    <!--
      设置窗口。

      事件挂载方式与主窗口一致：全部在 SettingsWindow.xaml.cpp 里用 lambda 挂，
      不走 XAML 的 Click= 处理器（C++/WinRT 的事件处理器必须在 IDL 里声明成
      runtimeclass 成员，每加一个按钮就要改 IDL 并触发 MIDL 重跑）。

      这里刻意**只用** RoutedEventHandler 一族（Click / Toggled），
      不碰 ComboBox.SelectionChanged：
        微软的事件委托在本版 cppwinrt（3.0.260818.1）里分两类，
        Microsoft.UI.Xaml.Controls.SelectionChangedEventHandler 这类
        **Microsoft.UI.\*** 命名空间的委托，模板构造函数漏了 inline，
        直接接会 LNK2019，绕开 make_delegate 又撞 base.h 的 C2027。
        实测只有 Windows.Foundation 那批（RoutedEventHandler /
        TypedEventHandler）是好的。
      所以 ComboBox 的当前值不在选择时读，而在「确定」被按下时一次性读回来
      —— 少两条事件通路，反而更不容易出错。

      【版式（2026-10-23 用户拍板，候选 C）】
        · 「关闭窗口时」用**下拉**，与上面的「默认排序」「采样间隔」同款行式，
          整个设置窗口只有一种行式样；
        · 「重新添加托盘图标」放在**标题栏右侧**。
      曾经还并行实现过「三行单选」与「药丸分段」两套版式做对照，
      拍板后已连同切换开关一起删除。
    -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto"
          Background="Transparent">

        <!-- ============================ 标题栏（可拖拽） ============================ -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel x:Name="DragRegion"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Margin="16,0,0,0"
                            Background="Transparent">
                    <FontIcon Glyph="&#xE713;" FontSize="14" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="设置"
                               VerticalAlignment="Center"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </StackPanel>

                <!-- 「重新添加托盘图标」放在标题栏右侧。
                     它在 DragRegion 之外，所以不会被拖拽区吃掉点击。 -->
                <Button x:Name="TrayRecreateButton" Grid.Column="2"
                        Content="重新添加托盘图标"
                        Style="{ThemeResource AccentButtonStyle}"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- ============================ 设置项 ============================ -->
        <StackPanel Grid.Row="1" Margin="24,8,24,16" Spacing="4">

            <!-- 1. 聚合开关 -->
            <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="按应用聚合" Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock Text="把同一应用的多个进程合并成一行"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.65"
                               Margin="0,2,0,0" />
                </StackPanel>
                <ToggleSwitch x:Name="AggregateSwitch" Grid.Column="1"
                              VerticalAlignment="Center" />
            </Grid>

            <!-- 2. 默认排序 -->
            <Grid Margin="0,12,0,0" ColumnDefinitions="*,180">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="默认排序" Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock Text="启动时以及点名称列回退到的排序方式"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.65"
                               Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox x:Name="SortCombo" Grid.Column="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          MinWidth="180">
                    <!-- 5 项对应 core::SortMode 的全部取值（SORT_MEM_DESC / MEM_ASC /
                         CPU_DESC / CPU_ASC / NAME_ASC）。方向箭头沿用主窗口表头与状态栏
                         已有的 ↓/↑ 约定。
                         曾经只列 3 项，结果 MEM_ASC 与 CPU_ASC 两个档位在设置里
                         永远选不到 —— 而它们明明能被主窗口表头点击设出来，用户却无法
                         把它设成默认值。设置项必须能表达底层取值的全部范围。 -->
                    <ComboBoxItem Content="内存占用 ↓" />
                    <ComboBoxItem Content="内存占用 ↑" />
                    <ComboBoxItem Content="CPU 占用 ↓" />
                    <ComboBoxItem Content="CPU 占用 ↑" />
                    <ComboBoxItem Content="名称 ↑" />
                </ComboBox>
            </Grid>

            <!-- 3. 采样间隔 -->
            <Grid Margin="0,12,0,0" ColumnDefinitions="*,180">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="采样间隔" Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock Text="越小越实时，占用也略高"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.65"
                               Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox x:Name="IntervalCombo" Grid.Column="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          MinWidth="180">
                    <ComboBoxItem Content="0.5 秒" />
                    <ComboBoxItem Content="1 秒" />
                    <ComboBoxItem Content="2 秒" />
                    <ComboBoxItem Content="5 秒" />
                </ComboBox>
            </Grid>

            <!-- 4. 开机自启动 -->
            <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="开机自启动" Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock Text="登录后静默运行到托盘，不弹主界面"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.65"
                               Margin="0,2,0,0" />
                </StackPanel>
                <ToggleSwitch x:Name="AutoStartSwitch" Grid.Column="1"
                              VerticalAlignment="Center" />
            </Grid>

            <!-- 自启失败提示。平时折叠，只有注册表写入真的失败了才显示，
                 否则用户会以为开关生效了。 -->
            <TextBlock x:Name="AutoStartError"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <!-- 5. 关闭窗口时的行为
                 三档与 core/settings.h 的 kCloseAsk / kCloseMinimizeToTray /
                 kCloseExitProgram 一一对应，下标就是档位值，所以这里读回来
                 不用再做映射。
                 这一项以前**没有 UI 入口**（设为 1 或 2 之后只能手改 ini 改回 0），
                 现在补上了。 -->
            <Grid Margin="0,12,0,0" ColumnDefinitions="*,180">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="关闭窗口时" Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock Text="点标题栏的 X 或按 Alt+F4 时的默认行为"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.65"
                               Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox x:Name="CloseActionCombo" Grid.Column="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          MinWidth="180">
                    <ComboBoxItem Content="每次询问" />
                    <ComboBoxItem Content="总是隐藏到托盘" />
                    <ComboBoxItem Content="总是退出程序" />
                </ComboBox>
            </Grid>

            <!-- 口径说明。内存数字的口径必须在界面上说清楚，
                 否则用户拿任务管理器对数会以为算错了。 -->
            <TextBlock Text="内存口径为「专用提交」，与任务管理器「进程」页的私有工作集略有差异。"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Opacity="0.5"
                       TextWrapping="Wrap"
                       Margin="0,20,0,0" />
        </StackPanel>

        <!-- ============================ 按钮 ============================ -->
        <Grid x:Name="ButtonBar" Grid.Row="2" Margin="24,0,24,20" ColumnDefinitions="*,Auto,Auto">
            <Button x:Name="CancelButton" Grid.Column="1"
                    Content="取消"
                    MinWidth="96"
                    Margin="0,0,8,0" />
            <Button x:Name="OkButton" Grid.Column="2"
                    Content="确定"
                    MinWidth="96"
                    Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
