<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LingwuToolbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      XamlControlsResources 是 **unpackaged** WinUI 3 的硬性前提，不是可选装饰。

      打包（MSIX）应用由打包系统自动注入这份资源字典；unpackaged 应用必须自己合并。
      漏掉它的症状非常安静：编译期完全正常（XAML 编译器不校验 ThemeResource 键是否存在），
      运行期 InitializeComponent 直接抛
          0x802B000A  Cannot find a Resource with the Name/Key TextFillColorPrimaryBrush
      窗口一个都创建不出来，且因为异常发生在 COM ABI 回调里，
      现象是「进程活着、零窗口、不崩、不写事件日志」。

      本工程踩过两次才定位：先是 AccentTextFillColorPrimaryBrush，
      换成 TextFillColorPrimaryBrush 之后连它也找不到 —— 说明不是「键名写错」，
      而是整张主题字典压根没加载。判据：连续两个不同键都找不到，就该怀疑字典缺失，
      而不是继续换键名试。

      合并之后才能用的东西包括：
        · TextFillColorPrimaryBrush / TextFillColorSecondaryBrush
        · BodyStrongTextBlockStyle / CaptionTextBlockStyle
        · ListView / Button / AutoSuggestBox / ContentDialog 的默认模板与主题资源
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              【应用内两枚小蜜蜂徽章 —— 本工程唯一一处用 ThemeDictionaries 的地方】

              为什么这里必须要主题字典（而下面那六个页签主色刻意不用）：
              2026-10-28 用户拍板把应用内的徽章底板去掉，改成**透明底**。
              但蜂的原图是「白蜂 + 黑条纹」—— 透明底之后，
              白色那一坨在**浅色主题**的容器（药丸 ≈ #F0F0F0、标题栏 ≈ #F3F3F3）上等于隐形。
              所以深色主题用白蜂、浅色主题必须换成黑蜂，两张图由主题字典选。

              两枚徽章：
                BeeNavLogo    —— 导航容器左端，28 DIP（bee-badge-64 / -light）
                BeeTitleLogo  —— 标题栏左上角，16 DIP（bee-badge-32 / -light）
              标题栏那枚是 2026-10-28 用户看截图指出「左上角这个也要改」之后
              才去掉的底板：浅色主题下那块近黑方底是一坨黑块，看着突兀。
              去掉之后，标题栏与导航徽章是同一套规则。

              【浅色主题那张不是把白蜂反色，而是另一张源图】
              2026-10-28 用户另外给了一张「可爱黑白卡通蜜蜂图标.png」（黑蜂白底）。
              它和白蜂那张**不是同一只造型**：头更大、触角更粗、笑脸不同，
              两张前景剪影的 IoU 只有 0.66 —— 反色只会得到「同一只的白底版」，
              形状还是白蜂那只，与用户给的这张对不上。
              所以浅色版单独走 resources\bee-source-light.png 抠图（plate=none），
              不用 invert。render-bee-art.py 里的反色分支保留备用。

              【为什么这次用 ThemeDictionaries 是安全的】
              下面那条注释说「ThemeDictionaries 要求每个键在 Light / HighContrast
              两套里都给出值，少一套就抛 0x802B000A」——
              那个坑的成因是**分支不全**，不是 ThemeDictionaries 本身有毒。
              这里三个分支（Default / Light / HighContrast）全部给出了
              BeeNavLogo 与 BeeTitleLogo，缺分支的事不会发生。

              【HighContrast 选白蜂的理由】
              Windows 的高对比度主题多数是黑底（白字），
              「High Contrast White」是少数派。白蜂在黑底 HC 上对比度最好。

              【exe / 托盘图标不用这一套】
              那两处各自有各的底色（任务栏、托盘、资源管理器列表），
              透明底会随系统主题变来变去，所以 app.ico 固定用近黑底板 + 白蜂。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <BitmapImage x:Key="BeeNavLogo"
                                 UriSource="ms-appx:///Assets/bee-badge-64.png" />
                    <BitmapImage x:Key="BeeTitleLogo"
                                 UriSource="ms-appx:///Assets/bee-badge-32.png" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <BitmapImage x:Key="BeeNavLogo"
                                 UriSource="ms-appx:///Assets/bee-badge-64-light.png" />
                    <BitmapImage x:Key="BeeTitleLogo"
                                 UriSource="ms-appx:///Assets/bee-badge-32-light.png" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <BitmapImage x:Key="BeeNavLogo"
                                 UriSource="ms-appx:///Assets/bee-badge-64.png" />
                    <BitmapImage x:Key="BeeTitleLogo"
                                 UriSource="ms-appx:///Assets/bee-badge-32.png" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
              【页签主色 —— 每页一个，2026-10-25 Gate 0 拍板】
              「每页独立主色」这条决策轴的结果：导航容器里当前页签的填充色
              跟着页面走，六个页面一眼可辨。

              为什么用**普通资源**而不是 ThemeDictionaries：
              ThemeDictionaries 要求每个键在 Light / HighContrast 两套里都给出值，
              少一套就在切主题时抛 0x802B000A「找不到资源」——
              那种失败发生在 InitializeComponent 里，症状是「窗口一个都建不出来」，
              极难定位。这里六色都取中调色，一份固定值就够了，不需要主题字典。

              为什么不用系统强调色统一一套：
              那会让六个页签长得一模一样，等于没有导航。

              取值口径：中调（不是深色也不是浅色），保证压在它上面的
              **反色文字**（主题的 TextOnAccentFillColorPrimaryBrush）
              对比度足够 —— 实测深色字在这几个色上是 4.70:1 ~ 5.21:1，
              白字反而只有 3.88:1 ~ 4.46:1（服务青上的白字不达标）。
              文字颜色由主题决定，不在这里写死。
            -->
            <SolidColorBrush x:Key="AccentClean"    Color="#3E7BD9" />  <!-- 清理：蓝 -->
            <SolidColorBrush x:Key="AccentApps"     Color="#C9525C" />  <!-- 应用：绛红 -->
            <SolidColorBrush x:Key="AccentOptimize" Color="#A86E22" />  <!-- 优化：赭 -->
            <SolidColorBrush x:Key="AccentAnalyze"  Color="#7B5BC4" />  <!-- 分析：紫 -->
            <SolidColorBrush x:Key="AccentStatus"   Color="#4E8529" />  <!-- 状态：橄榄绿 -->
            <SolidColorBrush x:Key="AccentService"  Color="#278C8C" />  <!-- 服务：青 -->

            <!--
              【指标语义色 —— 与页签主色是两套东西】
              磁贴里的小色块、迷你折线、进度条用的是「这个指标是什么」的语义色，
              跟「当前在哪个页签」无关。两套混用会让人以为颜色在表达页签。

              取值直接用 Gate 0 对照图里的那一组（同一张图上比出来的），
              所以实现出来的观感与拍板的那张一致。
            -->
            <SolidColorBrush x:Key="MetricHealth"   Color="#6CCB5F" />  <!-- 健康分：绿 -->
            <SolidColorBrush x:Key="MetricCpu"      Color="#4CC2FF" />  <!-- CPU：蓝 -->
            <SolidColorBrush x:Key="MetricMemory"   Color="#9D7FE0" />  <!-- 内存：紫 -->
            <SolidColorBrush x:Key="MetricDiskFree" Color="#F7B500" />  <!-- 磁盘剩余：琥珀 -->
            <SolidColorBrush x:Key="MetricNet"      Color="#5FD18A" />  <!-- 网络：绿 -->
            <SolidColorBrush x:Key="MetricDiskAct"  Color="#6F8FE0" />  <!-- 磁盘活动：蓝 -->
            <SolidColorBrush x:Key="MetricBattery"  Color="#F1707B" />  <!-- 电池：红 -->

            <!--
              【健康分的三档等级色】
              与上面的指标语义色**分开**：指标色回答「这是什么指标」，
              等级色回答「这个健康分算好还是差」。混用会让「磁盘剩余是琥珀色」
              被读成「健康分中等」。

              绿 / 琥珀 / 红与 MetricHealth / MetricDiskFree / MetricBattery
              取的是同一组色值，但在这里是**独立资源** —— 语义不同就不能共用名字。
            -->
            <SolidColorBrush x:Key="HealthGood" Color="#6CCB5F" />  <!-- 健康分良好 -->
            <SolidColorBrush x:Key="HealthWarn" Color="#F7B500" />  <!-- 健康分一般 -->
            <SolidColorBrush x:Key="HealthBad"  Color="#F1707B" />  <!-- 健康分较差 -->
        </ResourceDictionary>
    </Application.Resources>
</Application>