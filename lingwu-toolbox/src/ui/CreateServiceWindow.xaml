<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LingwuToolbox.CreateServiceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="新建服务">

    <Grid x:Name="RootGrid" RowDefinitions="*,Auto" Padding="24,16,24,24">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- 服务名。不可重命名这一点必须写在字段下面：
                     用户填错了以为之后能改，而实际上服务名一改就再也
                     找不到这个服务了（所有引用都按名字索引）。 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="服务名" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBox x:Name="ServiceNameBox" PlaceholderText="例如 MyAppService" />
                    <TextBlock Text="这是服务的唯一标识，创建后无法修改。只能包含字母、数字、下划线、连字符和点。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" Opacity="0.7" />
                    <TextBlock x:Name="ServiceNameError"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>

                <!-- 显示名 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="显示名" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBox x:Name="DisplayNameBox" PlaceholderText="在服务管理器里看到的名称" />
                    <TextBlock x:Name="DisplayNameError"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>

                <!-- 可执行路径 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="可执行文件路径" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="BinaryPathBox"
                                 Grid.Column="0"
                                 PlaceholderText="C:\Program Files\MyApp\service.exe" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…"
                                Margin="8,0,0,0" VerticalAlignment="Stretch" />
                    </Grid>
                    <TextBlock x:Name="BinaryPathError"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Name="BinaryPathWarning"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- 启动类型 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="启动类型" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="StartTypeBox" HorizontalAlignment="Left" Width="220"
                              ToolTipService.ToolTip="决定服务何时由系统启动" />
                </StackPanel>

                <!-- 运行账户 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="运行账户" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="AccountBox" HorizontalAlignment="Left" Width="320"
                              ToolTipService.ToolTip="服务以该账户的权限运行" />
                    <TextBlock Text="只支持三个内置账户。需要自定义账户的服务请用 services.msc 或 sc create 创建。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>

                <!-- 描述 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="描述" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBox x:Name="DescriptionBox" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="64"
                             PlaceholderText="可选，说明这个服务的用途" />
                </StackPanel>

                <!-- 立即启动 -->
                <CheckBox x:Name="StartImmediatelyBox" Content="创建后立即启动" />

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮行。固定在 ScrollViewer 之外，
             这样内容再长也不会把按钮顶出窗口。
             另加一行 24 DIP 的底边距：WinUI 的默认按钮贴着窗口底边时
             在 200% 缩放下会显得压边。 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <!-- IsEnabled="False" 是必须的初值，不要交给代码去改。
                 表单校验跑在 100 ms 的心跳上，窗口刚 Activate 出来到第一次
                 心跳之间存在一个真空期；不写这一句，用户就能在这段时间里
                 点出一个空表单的创建请求。 -->
            <Button x:Name="CreateButton" Content="创建" IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="CancelButton" Content="取消" />
        </StackPanel>
    </Grid>
</Window>
